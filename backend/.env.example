DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/cpcl_tender"
# Optional. If omitted, the backend derives cpcl_verification from DATABASE_URL.
VERIFICATION_DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/cpcl_verification"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="replace-with-another-long-random-secret"
REFRESH_TOKEN_EXPIRES_IN="7d"
PORT=5000
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"

# Email OTP configuration (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# External email request timeout in milliseconds.
RESEND_TIMEOUT_MS=15000

# Server-only Cloudinary configuration
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# External Cloudinary delivery timeout in milliseconds.
CLOUDINARY_TIMEOUT_MS=30000

# Server-only PaddleOCR configuration
# Relative paths are resolved from the backend directory.
# On Render/Linux, leave PADDLEOCR_PYTHON_PATH unset so build:render creates
# and installs into ocr-worker/.venv, which the backend selects automatically.
PADDLEOCR_PYTHON_PATH="ocr-worker/.venv/Scripts/python.exe"
PADDLEOCR_WORKER_PATH="ocr-worker/paddle_worker.py"
PADDLEOCR_DEVICE="cpu"
PADDLEOCR_TIMEOUT_MS=300000

